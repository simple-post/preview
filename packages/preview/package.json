{
  "name": "@simple-post/preview",
  "version": "0.1.0",
  "description": "Framework-agnostic, cross-platform social post preview renderer and Web Component.",
  "keywords": [
    "social-media",
    "post-preview",
    "web-component",
    "twitter",
    "instagram",
    "tiktok"
  ],
  "license": "MIT",
  "author": "Simple Post",
  "homepage": "https://github.com/simple-post/preview#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simple-post/preview.git",
    "directory": "packages/preview"
  },
  "bugs": {
    "url": "https://github.com/simple-post/preview/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/element.js",
    "./dist/element.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/element.ts --format esm,cjs --dts --clean",
    "clean": "rm -rf dist",
    "dev": "tsup src/index.ts src/element.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "engines": {
    "node": ">=20"
  }
}
